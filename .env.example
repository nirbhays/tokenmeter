# =============================================================================
# TokenMeter — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# NEVER commit the actual .env file to version control.
# All values below are placeholders — replace them before running.
# =============================================================================

# =============================================================================
# CORE
# =============================================================================

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (detailed error messages)
DEBUG=true

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# PostgreSQL connection string (async driver).
# Local development: postgresql+asyncpg://postgres:postgres@localhost:5432/tokenmeter
# Supabase production: postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tokenmeter

# =============================================================================
# CLICKHOUSE (Time-Series Metrics)
# =============================================================================

# ClickHouse connection for high-volume usage metrics.
# Local dev uses Docker; production can use ClickHouse Cloud.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=tokenmeter

# =============================================================================
# REDIS
# =============================================================================

# Redis connection string for caching and rate limiting.
# Local development: redis://localhost:6379/0
# Upstash production: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AUTH (Clerk)
# =============================================================================

# Clerk secret key for backend JWT validation.
# Found at: Clerk Dashboard -> API Keys -> Secret keys
CLERK_SECRET_KEY=

# Clerk publishable key (also needed in frontend as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Found at: Clerk Dashboard -> API Keys -> Publishable keys
CLERK_PUBLISHABLE_KEY=

# =============================================================================
# STRIPE (Billing)
# =============================================================================

# Stripe secret API key.
# Test mode: sk_test_xxxxx   Live mode: sk_live_xxxxx
STRIPE_SECRET_KEY=

# Stripe publishable key (also needed in frontend).
STRIPE_PUBLISHABLE_KEY=

# Stripe webhook signing secret.
# Found at: Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# These are the API keys for the LLM providers you want to route through.
# You only need keys for providers you want to support.

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google AI API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# =============================================================================
# BUDGET ALERTS
# =============================================================================

# Slack webhook URL for budget alert notifications.
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# SMTP settings for email alerts (optional).
# ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
# ALERT_EMAIL_SMTP_PORT=587
# ALERT_EMAIL_SMTP_USER=your-email@gmail.com
# ALERT_EMAIL_SMTP_PASSWORD=your-app-password
# ALERT_EMAIL_FROM=alerts@tokenmeter.dev

# =============================================================================
# CACHE
# =============================================================================

# Enable/disable response caching.
CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 3600 = 1 hour).
CACHE_TTL_SECONDS=3600

# =============================================================================
# ROUTING ENGINE
# =============================================================================

# Default routing mode: cost-optimized | latency-optimized | quality-optimized
ROUTING_DEFAULT_MODE=cost-optimized

# =============================================================================
# SECURITY
# =============================================================================

# Comma-separated list of allowed CORS origins.
# In production, set this to your frontend domain only.
CORS_ORIGINS=["http://localhost:3000"]

# When true, request/response bodies are NOT stored (privacy-first mode).
ZERO_LOGGING_MODE=false

# =============================================================================
# FRONTEND
# =============================================================================

# Frontend URL (used for CORS and redirects).
FRONTEND_URL=http://localhost:3000

# These variables are used by Next.js (must start with NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
